@class DictionaryLiteralsTest : NSObject

- runTests {
    id dict = @{@"name": @"AppScript", @"version": @"1"}
    id count = [dict count]
    id name = [dict objectForKey:@"name"]
    id result = [NSMutableArray array]
    [result addObject:count]
    [result addObject:name]
    return result
}

@end
