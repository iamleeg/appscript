@class StringEscapesTest : ASTestCase

- runTests {
    id result = [NSMutableArray array]
    id hexA = @"\x41"
    [result addObject:hexA]
    id unicodeA = @"\u0041"
    [result addObject:unicodeA]
    id bigUnicodeA = @"\U00000041"
    [result addObject:bigUnicodeA]
    id octalA = @"\101"
    [result addObject:octalA]
    id str = @"Hello\nWorld"
    id newlineParts = [str componentsSeparatedByString:@"\n"]
    [result addObject:[newlineParts objectAtIndex:0]]
    [result addObject:[newlineParts objectAtIndex:1]]
    id str2 = @"Foo\tBar"
    id tabParts = [str2 componentsSeparatedByString:@"\t"]
    [result addObject:[tabParts objectAtIndex:0]]
    [result addObject:[tabParts objectAtIndex:1]]
    return result
}

@end
