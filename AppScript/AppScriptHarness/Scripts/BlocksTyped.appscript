@class BlocksTypedTest : ASTestCase

- runTests {
    // -[NSArray enumerateObjectsUsingBlock:] calls the block with (id, NSUInteger, BOOL *): the index
    // arrives as an NSNumber, and setting the stop flag ends the loop.
    id seen = [NSMutableArray array]
    [@[@"b", @"a", @"c"] enumerateObjectsUsingBlock:^(obj idx stop) {
        [seen addObject:obj]
        [seen addObject:idx]
        [[idx isEqualToNumber:1] ifTrue:^{
            [stop setValue:YES]
        }]
    }]

    // -[NSArray sortedArrayUsingComparator:] needs the block to return an NSComparisonResult.
    id sorted = [@[@"b", @"a", @"c"] sortedArrayUsingComparator:^(a b) {
        return [b compare:a]
    }]

    return @[[seen componentsJoinedByString:@","], [sorted componentsJoinedByString:@","]]
}

@end
