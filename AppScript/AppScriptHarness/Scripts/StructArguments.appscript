@class StructArgumentsTest : ASTestCase

- runTests {
    id range = [ASFoundation NSMakeRange: 6 : 5]
    id loc = [range location]
    id len = [range length]
    id sub = [@"hello world" substringWithRange: range]
    id rangeStr = [ASFoundation NSStringFromRange: range]

    id rect = [ASFoundation NSMakeRect: 0 : 0 : 100 : 80]
    id inset = [ASFoundation NSInsetRect: rect : 10 : 5]
    id insetWidth = [[inset size] width]

    id result = [NSMutableArray array]
    [result addObject: loc]
    [result addObject: len]
    [result addObject: sub]
    [result addObject: rangeStr]
    [result addObject: insetWidth]
    return result
}

@end
