@class ProtocolLookupTest : ASTestCase <NSCopying, NSSecureCoding>

- runTests {
    id copyingProto = [@"NSCopying" as_protocol]
    id codingProto = [@"NSSecureCoding" as_protocol]
    id strConforms = [@"hello" conformsToProtocol:copyingProto]
    id objConforms = [[NSObject new] conformsToProtocol:copyingProto]
    id selfConforms = [self conformsToProtocol:copyingProto]
    id selfConformsSecond = [self conformsToProtocol:codingProto]

    id unknownProto = [@"NoSuchProtocolExistsInThisProcess_AppScript" as_protocol]
    id unknownIsNil = [unknownProto isNil]
    id unknownConforms = [self conformsToProtocol:unknownProto]

    id result = [NSMutableArray array]
    [result addObject:strConforms]
    [result addObject:objConforms]
    [result addObject:selfConforms]
    [result addObject:selfConformsSecond]
    [result addObject:unknownIsNil]
    [result addObject:unknownConforms]
    return result
}

@end
