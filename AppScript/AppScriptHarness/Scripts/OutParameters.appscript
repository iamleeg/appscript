@class OutParametersTest : ASTestCase

- runTests {
    // NSScanner reports what it scanned through NSInteger * and double * out-parameters.
    // A script passes an ASOutObject and reads the result with -value afterwards.
    id scanner = [NSScanner scannerWithString:@"42 3.5"]
    id count = [ASOutObject outObject]
    id ratio = [ASOutObject outObject]
    id scannedCount = [scanner scanInteger:count]
    id scannedRatio = [scanner scanDouble:ratio]

    // NSColor reports its four components through four CGFloat * out-parameters.
    id color = [NSColor colorWithCalibratedRed:0.25 green:0.5 blue:0.75 alpha:1.0]
    id red = [ASOutObject outObject]
    id green = [ASOutObject outObject]
    id blue = [ASOutObject outObject]
    id alpha = [ASOutObject outObject]
    [color getRed:red green:green blue:blue alpha:alpha]

    return @[scannedCount, [count value], scannedRatio, [ratio value],
             [red value], [green value], [blue value], [alpha value]]
}

@end
