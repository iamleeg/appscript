@class ConstantAccessTest : ASTestCase

- runTests {
    id url = [[NSBundle mainBundle] URLForResource:@"TestBridgeSupport" withExtension:@"bridgesupport"]
    id parser = [ASBridgeSupportParser new]
    id doc = [parser parseURL:url]

    id installer = [ASBridgeSupportInstaller new]
    [installer installDocument:doc frameworkName:@"HarnessConst"]

    id enumResult = [ASHarnessConst NSASCIIStringEncoding]
    id constResult = [ASHarnessConst NSNotFound]

    id result = [NSMutableArray array]
    [result addObject:enumResult]
    [result addObject:constResult]
    return result
}

@end
